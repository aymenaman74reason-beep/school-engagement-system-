# Server
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/school_management

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Password Reset
PASSWORD_RESET_EXPIRY=3600000

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@schoolms.com

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Logging
LOG_LEVEL=info

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Default Admin (created on first startup if no admin exists)
ADMIN_EMAIL=admin@schoolms.com
ADMIN_PASSWORD=YourVeryStrongPassword!@#$%
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator

# Your personal admin account (created once by `npm run seed`, never overwritten on restart)
OWNER_ADMIN_EMAIL=you@example.com
OWNER_ADMIN_PASSWORD=ChangeThis@123
OWNER_ADMIN_FIRST_NAME=Your
OWNER_ADMIN_LAST_NAME=Name
