{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@config": ["src/config"],
      "@config/*": ["src/config/*"],
      "@models": ["src/models"],
      "@models/*": ["src/models/*"],
      "@services": ["src/services"],
      "@services/*": ["src/services/*"],
      "@controllers": ["src/controllers"],
      "@controllers/*": ["src/controllers/*"],
      "@routes": ["src/routes"],
      "@routes/*": ["src/routes/*"],
      "@middleware": ["src/middleware"],
      "@middleware/*": ["src/middleware/*"],
      "@validators": ["src/validators"],
      "@validators/*": ["src/validators/*"],
      "@repositories": ["src/repositories"],
      "@repositories/*": ["src/repositories/*"],
      "@utils": ["src/utils"],
      "@utils/*": ["src/utils/*"],
      "@constants": ["src/constants"],
      "@constants/*": ["src/constants/*"],
      "@types": ["src/types"],
      "@types/*": ["src/types/*"],
      "@events": ["src/events"],
      "@events/*": ["src/events/*"],
      "@jobs": ["src/jobs"],
      "@jobs/*": ["src/jobs/*"]
    },
    "types": ["node", "jest"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests"]
}
